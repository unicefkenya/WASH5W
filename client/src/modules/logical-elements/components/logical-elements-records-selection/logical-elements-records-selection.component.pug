form
  .d-flex.flex-column.mb-3
    .p-2
      sb-search((searched)='onSearchTermChange($event)')
    .p-2
      sb-loading-animation
  .row
    .col
      sb-table
        ng-container(header='')
          tr
            th.col-sm-11.text-left.align-middle(scope='col') Name 
            th.col-sm-1.text-center.align-middle(scope='col') Select
        ng-container(body='')
          tr(*ngfor='let logicalElement of logicalElementsDataService.logicalElements$ | async')
            td.text-left.align-middle
              | {{logicalElement.data?.name}}
            td.text-center.align-middle
              span.d-flex.justify-content-center
                div(*ngif='selectionMode === "single"; else multi')
                  sb-button(action='select', entity='LogicalElement', id='{{logicalElement.id}}', name='logicalElement', [selected]='isSelected(logicalElement.id)', [disabled]='isSelected(logicalElement.id) && disableSelectedLogicalElementIdsTreatment', (select)='onSelect($event)')
                ng-template(#multi='')
                  sb-button(action='check', entity='LogicalElement', id='{{logicalElement.id}}', name='logicalElement', [checked]='isChecked(logicalElement.id)', [disabled]='isChecked(logicalElement.id) && disableSelectedLogicalElementIdsTreatment', (check)='onCheck($event)', (uncheck)='onUncheck($event)')
  .row
    .col
      sb-pagination(type='modal', (pagechanged)='onPageChange($event)', (pagesizechanged)='onPageSizeChange($event)')
