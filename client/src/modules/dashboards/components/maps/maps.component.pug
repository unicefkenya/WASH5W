.card.bg-white.text-dark.border-top-0.border-bottom-0.border-right-0.border-left-lg.shadow([style]="'border-color:' + primaryVisualisationVariable.color + ';'")
  .card-body
    .d-flex.flex-column.justify-content-center
      span.text-uppercase.text-center
        | {{primaryVisualisationVariable?.label}}
      span.font-weight-bold.text-center
        span([countup]='primaryVisualisationVariableQuantityObservation?.amount', [options]='{decimalPlaces: primaryVisualisationVariableQuantityObservation?.decimalPlaces}') 0
        span(*ngif='variableCount == 1')
          | {{primaryVisualisationVariableQuantityObservationUnit?.symbol}}
      ng-container(*ngif='variableCount > 1')
        span.text-center
          small
            | {{secondaryVisualisationVariable?.label}} :
            span([countup]='secondaryVisualisationVariableQuantityObservation?.amount', [options]='{decimalPlaces: secondaryVisualisationVariableQuantityObservation?.decimalPlaces}') 0
      ng-container(*ngif='variableCount == 1')
        span.text-center
          small
            span {{visualisation?.emergency}}
