form
  .d-flex.flex-column.mb-3
    .p-2
      sb-search((searched)='onSearchTermChange($event)')
    .p-2
      sb-loading-animation
  .row
    .col
      sb-table
        ng-container(header='')
          tr
            th.col-sm-11.text-left.align-middle(scope='col') Name 
            th.col-sm-1.text-center.align-middle(scope='col') Select
        ng-container(body='')
          tr(*ngfor='let entityType of entitiesTypesDataService.entitiesTypes$ | async')
            td.text-left.align-middle
              | {{entityType.data?.name}}
            td.text-center.align-middle
              span.d-flex.justify-content-center
                div(*ngif='selectionMode === "single"; else multi')
                  sb-button(action='select', entity='EntityType', id='{{entityType.id}}', name='entityType', [selected]='isSelected(entityType.id)', [disabled]='isSelected(entityType.id) && disableSelectedEntityTypeIdsTreatment', (select)='onSelect($event)')
                ng-template(#multi='')
                  sb-button(action='check', entity='EntityType', id='{{entityType.id}}', name='entityType', [checked]='isChecked(entityType.id)', [disabled]='isChecked(entityType.id) && disableSelectedEntityTypeIdsTreatment', (check)='onCheck($event)', (uncheck)='onUncheck($event)')
  .row
    .col
      sb-pagination(type='modal', (pagechanged)='onPageChange($event)', (pagesizechanged)='onPageSizeChange($event)')
