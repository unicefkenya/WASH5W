form
  .d-flex.flex-column.mb-3
    .p-2
      sb-search((searched)='onSearchTermChange($event)')
    .p-2
      sb-loading-animation
  .row
    .col
      sb-table
        ng-container(header='')
          tr
            th.col-sm-11.text-left.align-middle(scope='col') Name 
            th.col-sm-1.text-center.align-middle(scope='col') Select
        ng-container(body='')
          tr(*ngfor='let workflowTransition of workflowTransitionsDataService.workflowTransitions$ | async')
            td.text-left.align-middle
              | {{workflowTransition.data?.name}}
            td.text-center.align-middle
              span.d-flex.justify-content-center
                div(*ngif='selectionMode === "single"; else multi')
                  sb-button(action='select', entity='WorkflowTransition', id='{{workflowTransition.id}}', name='workflowTransition', [selected]='isSelected(workflowTransition.id)', [disabled]='isSelected(workflowTransition.id) && disableSelectedWorkflowTransitionIdsTreatment', (select)='onSelect($event)')
                ng-template(#multi='')
                  sb-button(action='check', entity='WorkflowTransition', id='{{workflowTransition.id}}', name='workflowTransition', [checked]='isChecked(workflowTransition.id)', [disabled]='isChecked(workflowTransition.id) && disableSelectedWorkflowTransitionIdsTreatment', (check)='onCheck($event)', (uncheck)='onUncheck($event)')
  .row
    .col
      sb-pagination(type='modal', (pagechanged)='onPageChange($event)', (pagesizechanged)='onPageSizeChange($event)')
