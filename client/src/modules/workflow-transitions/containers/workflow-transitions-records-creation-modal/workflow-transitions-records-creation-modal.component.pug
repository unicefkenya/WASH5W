sb-modal(shadow='false')
  ng-container(title='')
    | Create Workflow Transition Record
  ng-container(body='')
    sb-workflow-transitions-records-creation((initialised)='onInitialised()', (succeeded)='onSucceeded()', (failed)='onFailed($event)')
    ng-container(*ngif='(status$ | async) === "initialising"')
      sb-message-overlay(activity='creating', status='initialising')
    ng-container(*ngif='(status$ | async) === "saving"')
      sb-message-overlay(activity='creating', status='saving')
    ng-container(*ngif='(status$ | async) === "succeeded"')
      sb-message-overlay(activity='creating', status='succeeded')
    ng-container(*ngif='(status$ | async) === "failed"')
      sb-message-overlay(activity='creating', status='failed')
    ng-container(*ngif='(status$ | async) === "retrying"')
      sb-countdown-overlay(crosshead='Retrying in ', (completed)='onSave()')
  ng-container(footer='')
    ng-container(*ngif='(status$ | async) === "ready"')
      sb-button(action='save', entity='WorkflowTransition', (save)='onSave()')
    ng-container(*ngif='(status$ | async) === "saving"')
      sb-button(action='save', entity='WorkflowTransition', disabled='true')
    ng-container(*ngif='(status$ | async) === "invalid"')
      sb-button(action='save', entity='WorkflowTransition', (save)='onSave()')
    ng-container(*ngif='(status$ | async) === "succeeded"')
      sb-button(action='yes', entity='WorkflowTransition', guarded='false', (yes)='onContinue()')
      sb-button(action='no', entity='WorkflowTransition', guarded='false', (no)='onQuit()')
    ng-container(*ngif='(status$ | async) === "failed"')
      sb-button(action='yes', entity='WorkflowTransition', (yes)='onRetry()')
      sb-button(action='no', entity='WorkflowTransition', guarded='false', (no)='onQuit()')
    ng-container(*ngif='(status$ | async) === "retrying"')
      sb-button(action='yes', entity='WorkflowTransition', disabled='true')
      sb-button(action='no', entity='WorkflowTransition', disabled='true')
