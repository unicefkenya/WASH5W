ngcontainer([ngswitch]='initialised')
  // Display the data form if the component was successfully initialised
  form(*ngswitchcase='initialised == true')
    .d-flex.bd-highlight
      .w-100.bd-highlight
        sb-search(placeholder='Search by systemsModules names', (searched)='onSearchTermChange($event)')
      .flex-shrink-1.bd-highlight
        sb-loading-animation
    .row
      .col
        sb-table
          ng-container(header='')
            tr
              th.col-sm-11.text-left.align-middle(scope='col') Name 
              th.col-sm-1.text-center.align-middle(scope='col') Select
          ng-container(body='')
            ng-container(*ngif='desired.length > 0; else desiredUnspecified')
              ng-container(*ngfor='let systemModule of systemsModulesDataService.systemsModules$ | async')
                tr(*ngif='isDesired(systemModule)')
                  td.text-left.align-middle
                    | {{systemModule.data?.name}}
                  td.text-center.align-middle
                    span.d-flex.justify-content-center
                      div(*ngif='selectionMode === "single"; else multi')
                        sb-button(action='select', entity='SystemModule', id='{{systemModule.id}}', name='systemModule', [selected]='isSelected(systemModule)', (select)='onSelect(systemModule)')
                      ng-template(#multi='')
                        sb-button(action='check', entity='SystemModule', id='{{systemModule.id}}', name='systemModule', [checked]='isChecked(systemModule)', (check)='onCheck(systemModule)', (uncheck)='onUncheck($event)')
            ng-container(#desiredunspecified='')
              ng-container(*ngif='undesired.length > 0; else undesiredUnspecified')
                ng-container(*ngfor='let systemModule of systemsModulesDataService.systemsModules$ | async')
                  tr(*ngif='!isUndesired(systemModule)')
                    td.text-left.align-middle
                      | {{systemModule.data?.name}}
                    td.text-center.align-middle
                      span.d-flex.justify-content-center
                        div(*ngif='selectionMode === "single"; else multi')
                          sb-button(action='select', entity='SystemModule', id='{{systemModule.id}}', name='systemModule', [selected]='isSelected(systemModule)', (select)='onSelect(systemModule)')
                        ng-template(#multi='')
                          sb-button(action='check', entity='SystemModule', id='{{systemModule.id}}', name='systemModule', [checked]='isChecked(systemModule)', (check)='onCheck(systemModule)', (uncheck)='onUncheck($event)')
              ng-container(#undesiredunspecified='')
                tr(*ngfor='let systemModule of systemsModulesDataService.systemsModules$ | async')
                  td.text-left.align-middle
                    | {{systemModule.data?.name}}
                  td.text-center.align-middle
                    span.d-flex.justify-content-center
                      div(*ngif='selectionMode === "single"; else multi')
                        sb-button(action='select', entity='SystemModule', id='{{systemModule.id}}', name='systemModule', [selected]='isSelected(systemModule)', (select)='onSelect(systemModule)')
                      ng-template(#multi='')
                        sb-button(action='check', entity='SystemModule', id='{{systemModule.id}}', name='systemModule', [checked]='isChecked(systemModule)', (check)='onCheck(systemModule)', (uncheck)='onUncheck($event)')
    .row
      .col
        sb-pagination(type='modal', (pagechanged)='onPageChange($event)', (pagesizechanged)='onPageSizeChange($event)')
  // Display an error message if the component was not successfully initialised
  .jumbotron(*ngswitchcase='initialised == false')
    h1.display-4 Oops
    p.lead We are sorry we cannot display the Systems Modules at this moment
    hr.my-4
    p Please try again in a little while
  // Display a loading screen otherwise
  sb-loading-animation(*ngswitchdefault='')
