form([formgroup]='systemsModulesPermissionsForm')
  // Name
  .form-group
    label(for='name') Name
    input#name.form-control(type='text', placeholder='', formcontrolname='name')
    .alert.alert-danger.mt-3(*ngif="systemsModulesPermissionsForm.get('name')?.invalid && (systemsModulesPermissionsForm.get('name')?.dirty || systemsModulesPermissionsForm.get('name')?.touched)")
      div(*ngif="systemsModulesPermissionsForm.get('name')?.errors.required")
        | Name is required
      div(*ngif="systemsModulesPermissionsForm.get('name')?.errors.minlength")
        | Name should be at least 2 characters long
      div(*ngif="systemsModulesPermissionsForm.get('name')?.errors.maxlength")
        | Name should not be more than 250 characters long
      div(*ngif="systemsModulesPermissionsForm.get('name')?.errors.exists")
        | Name should be unique
  // Type
  .form-group
    label(for='plural') Type
    input#plural.form-control(type='text', placeholder='', formcontrolname='plural')
    .alert.alert-danger.mt-3(*ngif="systemsModulesPermissionsForm.get('plural')?.invalid && (systemsModulesPermissionsForm.get('plural')?.dirty || systemsModulesPermissionsForm.get('plural')?.touched)")
      div(*ngif="systemsModulesPermissionsForm.get('plural')?.errors.required")
        | Type is required
      div(*ngif="systemsModulesPermissionsForm.get('plural')?.errors.minlength")
        | Type should be at least 2 characters long
      div(*ngif="systemsModulesPermissionsForm.get('plural')?.errors.maxlength")
        | Type should not be more than 250 characters long
      div(*ngif="systemsModulesPermissionsForm.get('plural')?.errors.exists")
        | Type should be unique
