form
  .d-flex.flex-column.mb-3
    .p-2
      sb-search((searched)='onSearchTermChange($event)')
    .p-2
      sb-loading-animation
  .row
    .col
      sb-table
        ng-container(header='')
          tr
            th.col-sm-11.text-left.align-middle(scope='col') Name 
            th.col-sm-1.text-center.align-middle(scope='col') Select
        ng-container(body='')
          tr(*ngfor='let entity of entitiesDataService.entities$ | async')
            td.text-left.align-middle
              | {{entity.data?.name}}
            td.text-center.align-middle
              span.d-flex.justify-content-center
                div(*ngif='selectionMode === "single"; else multi')
                  sb-button(action='select', entity='Entity', id='{{entity.id}}', name='entity', [selected]='isSelected(entity.id)', [disabled]='isSelected(entity.id) && disableSelectedEntityIdsTreatment', (select)='onSelect($event)')
                ng-template(#multi='')
                  sb-button(action='check', entity='Entity', id='{{entity.id}}', name='entity', [checked]='isChecked(entity.id)', [disabled]='isChecked(entity.id) && disableSelectedEntityIdsTreatment', (check)='onCheck($event)', (uncheck)='onUncheck($event)')
  .row
    .col
      sb-pagination(type='modal', (pagechanged)='onPageChange($event)', (pagesizechanged)='onPageSizeChange($event)')
