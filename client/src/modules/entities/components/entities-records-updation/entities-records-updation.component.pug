form([formgroup]='entitiesForm')
  // Name
  .form-group
    label(for='name') Name
    input#name.form-control(type='text', placeholder='', formcontrolname='name')
    .alert.alert-danger.mt-3(*ngif="entitiesForm.get('name')?.invalid && (entitiesForm.get('name')?.dirty || entitiesForm.get('name')?.touched)")
      div(*ngif="entitiesForm.get('name')?.errors.required")
        | Name is required
      div(*ngif="entitiesForm.get('name')?.errors.minlength")
        | Name should be at least 2 characters long
      div(*ngif="entitiesForm.get('name')?.errors.maxlength")
        | Name should not be more than 250 characters long
      div(*ngif="entitiesForm.get('name')?.errors.exists")
        | Name should be unique
  // Type
  .form-group
    label(for='plural') Type
    input#plural.form-control(type='text', placeholder='', formcontrolname='plural')
    .alert.alert-danger.mt-3(*ngif="entitiesForm.get('plural')?.invalid && (entitiesForm.get('plural')?.dirty || entitiesForm.get('plural')?.touched)")
      div(*ngif="entitiesForm.get('plural')?.errors.required")
        | Type is required
      div(*ngif="entitiesForm.get('plural')?.errors.minlength")
        | Type should be at least 2 characters long
      div(*ngif="entitiesForm.get('plural')?.errors.maxlength")
        | Type should not be more than 250 characters long
      div(*ngif="entitiesForm.get('plural')?.errors.exists")
        | Type should be unique
